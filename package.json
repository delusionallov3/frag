{
  "name": "frag",
  "productName": "Frag",
  "version": "0.4.0",
  "description": "Découpe tes recs Valorant en clips, vite et proprement.",
  "main": "./out/main/index.js",
  "author": "Lorenzo",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').existsSync('node_modules/electron/path.txt')||require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit'})\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "22.20.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.8.7",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "zustand": "5.0.8"
  }
}
